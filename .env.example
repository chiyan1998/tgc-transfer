# TGC Transfer 环境变量模板
# 复制为 .env.local 并填入真实值：cp .env.example .env.local && chmod 600 .env.local
# .env.local 已被 .gitignore 排除，切勿提交或打包上传。

# ---- LLM（OpenAI 兼容端点，安全五层防护见 design/architecture.md §7）----
# 配置优先级：设置页「快速概要模型」（管理员，AES-256-GCM 加密入库）> 以下环境变量。
# 例：https://api.openai.com/v1 或其他兼容网关
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 快速概要并发上限（限流保护，默认 1）
LLM_MAX_CONCURRENCY=1

# ---- 数据源 ----
# Crossref 礼貌邮箱（官方要求，免费，填你的常用邮箱即可）
UNPAYWALL_EMAIL=

# ---- 认证 ----
# 生成方式：openssl rand -base64 32
AUTH_SECRET=
# 首位注册此邮箱的用户自动成为管理员
ADMIN_EMAIL=
# 是否开放注册（true/false），关闭后仅管理员可建号
ALLOW_REGISTRATION=true

# ---- 邮件（注册验证，阿里云邮件推送 DirectMail，见 design/deployment-aliyun.md §6）----
# 三项必填才能启用发信，否则注册接口降级提示「邮件服务未配置」
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER = 完整发信地址（如 noreply@mail.你的域名.com）
# SMTP_PASS = 控制台「设置 SMTP 密码」的专用密码（非阿里云账号密码）
SMTP_USER=
SMTP_PASS=
SMTP_FROM=虎妞小猫学术信息中转站 <noreply@mail.你的域名.com>
# 验证邮件链接前缀，生产环境必须为正式域名（末尾无斜杠）
APP_BASE_URL=https://你的域名.com

# ---- 存储 ----
# 数据目录（SQLite + 备份），默认项目根下 ./data
# TGC_DATA_DIR=./data
